---
import { getCollection } from 'astro:content';
import { i18nConfig, withLangPrefix, type Lang } from '../../i18n/config';
import { pagesText } from '../../i18n/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = pagesText[lang].blog;
const byDate = (a: any, b: any) =>
  (b.data.updatedDate ?? b.data.publishedDate).getTime() - (a.data.updatedDate ?? a.data.publishedDate).getTime();
// Solo artículos del idioma: nunca se mezclan idiomas en un listado (SEO).
const posts = (await getCollection('blog')).filter((p) => p.data.lang === lang).sort(byDate);
const fmt = new Intl.DateTimeFormat(i18nConfig[lang].locale.replace('_', '-'), { year: 'numeric', month: 'long', day: 'numeric' });
const cleanTitle = (s: string) => s.replace(/\s*\|\s*Spain Global Hub\s*$/i, '');
---

<div class="sgh-list">
  <h1>{t.h1}</h1>
  <p class="sgh-list-intro">{t.intro}</p>
  {posts.length === 0 && <p class="sgh-soon">{t.empty}</p>}
  <div class="sgh-cards sgh-cards-posts">
    {posts.map((p) => {
      const date = p.data.updatedDate ?? p.data.publishedDate;
      return (
        <a class="sgh-card sgh-card-post" href={withLangPrefix(lang, `/${p.data.slug}/`)}>
          <span class="sgh-card-img">
            <img src={p.data.image ?? '/img/cover-fiscal.svg'} alt={p.data.imageAlt ?? ''} loading="lazy" width="600" height="338" />
          </span>
          <span class="sgh-card-body">
            <time datetime={date.toISOString().slice(0, 10)}>{fmt.format(date)}</time>
            <h3>{cleanTitle(p.data.title)}</h3>
            <p>{p.data.description}</p>
            <span class="more">{t.readMore}</span>
          </span>
        </a>
      );
    })}
  </div>
</div>
