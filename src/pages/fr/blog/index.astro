---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/listing/PostList.astro';
import { pagesText, listingUrls } from '../../../i18n/pages';

const SITE_URL = 'https://spaingh.com';
const t = pagesText['fr'].blog;
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang="fr"
  canonicalUrl={`${SITE_URL}${listingUrls.blog.fr}`}
  translations={[
    { lang: 'es', url: `${SITE_URL}${listingUrls.blog.es}` },
    { lang: 'en', url: `${SITE_URL}${listingUrls.blog.en}` },
  ]}
>
  <PostList lang="fr" />
</BaseLayout>
