---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactForm from '../../../components/contact/ContactForm.astro';
import { contactText, contactUrls } from '../../../i18n/contact';

const SITE_URL = 'https://spaingh.com';
const t = contactText['es'];
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang="es"
  canonicalUrl={`${SITE_URL}${contactUrls.es}`}
  translations={[
    { lang: 'en', url: `${SITE_URL}${contactUrls.en}` },
    { lang: 'fr', url: `${SITE_URL}${contactUrls.fr}` },
  ]}
>
  <ContactForm lang="es" />
</BaseLayout>
