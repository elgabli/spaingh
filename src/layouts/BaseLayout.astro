---
import SeoHead from '../components/seo/SeoHead.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Analytics from '../components/layout/Analytics.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';
import { i18nConfig, type Lang } from '../i18n/config';
import '../styles/global.css';

interface Translation {
  lang: Lang;
  url: string;
}

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonicalUrl: string;
  translations?: Translation[];
  noindex?: boolean;
  /** Nodos schema.org adicionales de la página (Article, FAQPage, WebApplication...). */
  schemaNodes?: object[];
  /** Homes: secciones a sangre completa que ya traen su propio hueco para el
   * header fijo (.sgh2{padding-top:70px}); <main> no debe añadir otro. */
  fullBleed?: boolean;
  /** og:image absoluta de la página (por defecto la genérica del sitio). */
  ogImage?: string;
}

const { title, description, lang, canonicalUrl, translations, noindex, schemaNodes, fullBleed = false, ogImage } = Astro.props;
const locale = i18nConfig[lang].locale;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      lang={lang}
      canonicalUrl={canonicalUrl}
      translations={translations}
      noindex={noindex}
      ogImage={ogImage}
    />
    <JsonLd nodes={schemaNodes} />
    <meta property="og:locale" content={locale} />
    <Analytics />
    <script is:inline defer src="https://servidor-all.tail77e746.ts.net:8443/script.js" data-website-id="e6794027-31c7-4d6e-8f83-2cb372d31baf"></script>
  </head>
  <body>
    <Header lang={lang} translations={translations} />
    <main class:list={{ 'sgh-main-fullbleed': fullBleed }}>
      <slot />
    </main>
    <Footer lang={lang} />
    {!Astro.url.pathname.includes('/contact') && (
      <a class="sgh-wa-float" href="https://wa.me/34601555547" rel="noopener" target="_blank" aria-label="WhatsApp" data-wa>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c1.7.7 2.1.6 2.8.5a2.4 2.4 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1c0-.1-.2-.2-.5-.3z"/></svg>
      </a>
    )}
    <script>
      document.querySelector('[data-wa]')?.addEventListener('click', () => { const w = window as unknown as { gtag?: (...a: unknown[]) => void }; w.gtag?.('event', 'sgh_whatsapp_click', { page: location.pathname }); (w as any).umami?.track('whatsapp', { tipo: 'flotante' }); });
    </script>
    <CookieBanner lang={lang} />
  </body>
</html>
