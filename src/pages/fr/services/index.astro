---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServicesList from '../../../components/listing/ServicesList.astro';
import { pagesText, listingUrls } from '../../../i18n/pages';

const SITE_URL = 'https://spaingh.com';
const t = pagesText['fr'].services;
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang="fr"
  canonicalUrl={`${SITE_URL}${listingUrls.services.fr}`}
  translations={[
    { lang: 'es', url: `${SITE_URL}${listingUrls.services.es}` },
    { lang: 'en', url: `${SITE_URL}${listingUrls.services.en}` },
  ]}
>
  <ServicesList lang="fr" />
</BaseLayout>
