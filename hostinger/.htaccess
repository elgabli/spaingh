# spaingh.com en Hostinger (LiteSpeed). Sustituye a functions/_middleware.js, public/_redirects y a la Function /api/contact.
# Generado desde public/_redirects por hostinger/build-htaccess (no editar a mano las reglas de redireccion).

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

RewriteEngine On
RewriteBase /

# Solo aplica al host principal (por si hay carpetas de otras apps colgando de public_html)
RewriteCond %{HTTP_HOST} !^(www\.)?spaingh\.com$ [NC]
RewriteRule ^ - [L]

# HTTPS y www -> apex (equivale a _middleware.js)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://spaingh.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.spaingh\.com$ [NC]
RewriteRule ^ https://spaingh.com%{REQUEST_URI} [R=301,L]

# Rutas internas que no deben servirse (el enlace domains/ es el docroot de wp.spaingh.com)
RewriteRule ^\.git(/|$) - [R=404,L]
RewriteRule ^(domains|config|hostinger)(/|$) - [R=404,L]
RewriteRule ^(_redirects|_headers|wrangler\.toml)$ - [R=404,L]

# API (antes Pages Function)
RewriteRule ^api/contact/?$ api/contact.php [L]

# ---- Redirecciones 301 (de public/_redirects) ----
RewriteRule ^en/politica\-de\-cookies\-2/?$ /en/cookie-policy/ [R=301,L]
RewriteRule ^contacto/?$ /es/contacto/ [R=301,L]
RewriteRule ^sobre\-nosotros/?$ /es/sobre-nosotros/ [R=301,L]
RewriteRule ^calculadora\-ley\-beckham\-calcula\-tus\-impuestos\-como\-expatriado\-en\-espana/?$ /es/calculadora-ley-beckham/ [R=301,L]
RewriteRule ^step\-to\-apply\-tourist\-visa\-in\-spain\-from\-kuwait/?$ /en/step-to-apply-tourist-visa-in-spain-from-kuwait/ [R=301,L]
RewriteRule ^invertir\-en\-el\-mercado\-inmobiliario\-de\-madrid/?$ /es/ [R=301,L]
RewriteRule ^spain\-tourist\-visa\-from\-dubai\-your\-guide\-to\-a\-seamless\-application/?$ /en/spain-tourist-visa-from-dubai-your-guide-to-a-seamless-application/ [R=301,L]
RewriteRule ^como\-crear\-una\-empresa\-en\-espana\-guia\-completa\-para\-extranjeros\-en\-2025/?$ /es/servicios/creacion-de-empresas-en-espana/ [R=301,L]
RewriteRule ^ar/invertir\-en\-el\-mercado\-inmobiliario\-de\-madrid/?$ /es/ [R=301,L]
