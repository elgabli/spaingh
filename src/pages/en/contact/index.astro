---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactForm from '../../../components/contact/ContactForm.astro';
import { contactText, contactUrls } from '../../../i18n/contact';

const SITE_URL = 'https://spaingh.com';
const t = contactText['en'];
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang="en"
  canonicalUrl={`${SITE_URL}${contactUrls.en}`}
  translations={[
    { lang: 'es', url: `${SITE_URL}${contactUrls.es}` },
    { lang: 'fr', url: `${SITE_URL}${contactUrls.fr}` },
  ]}
>
  <ContactForm lang="en" />
</BaseLayout>
