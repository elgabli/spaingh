RewriteRule ^en/calculadora\-ley\-beckham\-calcula\-tus\-impuestos\-como\-expatriado\-en\-espana/?$ /en/beckham-law-calculator/ [R=301,L]
RewriteRule ^en/como\-crear\-una\-empresa\-en\-espana\-guia\-completa\-para\-extranjeros\-en\-2025/?$ /en/services/strategic-corporate-deployment-in-spain/ [R=301,L]
RewriteRule ^fr/como\-crear\-una\-empresa\-en\-espana\-guia\-completa\-para\-extranjeros\-en\-2025/?$ /fr/services/company-formation-spain-premium-investment/ [R=301,L]
RewriteRule ^fr/calculateur\-loi\-beckham\-2026/?$ /fr/calculateur-loi-beckham/ [R=301,L]
RewriteRule ^fr/services/oi\-beckham/?$ /fr/calculateur-loi-beckham/ [R=301,L]
