---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/listing/PostList.astro';
import { pagesText, listingUrls } from '../../../i18n/pages';

const SITE_URL = 'https://spaingh.com';
const t = pagesText['en'].blog;
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang="en"
  canonicalUrl={`${SITE_URL}${listingUrls.blog.en}`}
  translations={[
    { lang: 'es', url: `${SITE_URL}${listingUrls.blog.es}` },
    { lang: 'fr', url: `${SITE_URL}${listingUrls.blog.fr}` },
  ]}
>
  <PostList lang="en" />
</BaseLayout>
