---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServicesList from '../../../components/listing/ServicesList.astro';
import { pagesText, listingUrls } from '../../../i18n/pages';

const SITE_URL = 'https://spaingh.com';
const t = pagesText['en'].services;
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang="en"
  canonicalUrl={`${SITE_URL}${listingUrls.services.en}`}
  translations={[
    { lang: 'es', url: `${SITE_URL}${listingUrls.services.es}` },
    { lang: 'fr', url: `${SITE_URL}${listingUrls.services.fr}` },
  ]}
>
  <ServicesList lang="en" />
</BaseLayout>
