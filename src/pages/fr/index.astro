---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/home/Home.astro';

const SITE_URL = 'https://spaingh.com';
---

<BaseLayout
  title="Conseil pour Investisseurs et Expatriés en Espagne | Spain Global Hub"
  description="Conseil juridique, fiscal et de résidence pour expatriés et investisseurs en Espagne : Loi Beckham, Nomade Numérique, PHQ et création de sociétés."
  lang="fr"
  fullBleed
  canonicalUrl={`${SITE_URL}/fr/`}
  translations={[
    { lang: 'es', url: `${SITE_URL}/es/` },
    { lang: 'en', url: `${SITE_URL}/en/` },
  ]}
>
  <Home lang="fr" />
</BaseLayout>
