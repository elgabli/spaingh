---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServicesList from '../../../components/listing/ServicesList.astro';
import { pagesText, listingUrls } from '../../../i18n/pages';

const SITE_URL = 'https://spaingh.com';
const t = pagesText['es'].services;
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang="es"
  canonicalUrl={`${SITE_URL}${listingUrls.services.es}`}
  translations={[
    { lang: 'en', url: `${SITE_URL}${listingUrls.services.en}` },
    { lang: 'fr', url: `${SITE_URL}${listingUrls.services.fr}` },
  ]}
>
  <ServicesList lang="es" />
</BaseLayout>
