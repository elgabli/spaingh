---
import { organization, website } from '../../lib/schema';

interface Props {
  /** Nodos adicionales del @graph (Article, FAQPage, WebApplication, etc.),
   * generados con los helpers de src/lib/schema.ts — nunca a mano. */
  nodes?: object[];
}

const { nodes = [] } = Astro.props;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...nodes],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
