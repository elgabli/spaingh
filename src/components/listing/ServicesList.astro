---
import { getCollection } from 'astro:content';
import { i18nConfig, withLangPrefix, type Lang } from '../../i18n/config';
import { pagesText, PILAR_ORDER } from '../../i18n/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = pagesText[lang].services;
const entries = (await getCollection('pilares')).filter((p) => p.data.lang === lang);
const contactHref = withLangPrefix(lang, `${i18nConfig[lang].nav.contact.href}?origen=servicios`);
const groups = PILAR_ORDER.map((pilar) => ({
  pilar,
  ...t.pilares[pilar],
  pages: entries.filter((e) => e.data.pilar === pilar).map((e) => {
    const slug = e.data.slug; const file = (e as { filePath?: string }).filePath ?? '';
    const kind = /^(servicios|services)\//.test(slug) ? 'service' : /\/(ley-beckham|nomada-digital)\.mdx?$/.test(file) ? 'tool' : 'guide';
    return { href: withLangPrefix(lang, `/${slug}/`), title: e.data.title.replace(/\s*\|\s*Spain Global Hub\s*$/i, ''), description: e.data.description, kind };
  }).sort((a, b) => ({ service: 0, tool: 1, guide: 2 }[a.kind] - { service: 0, tool: 1, guide: 2 }[b.kind])),
}));
const KIND: Record<Lang, Record<string, string>> = {
  es: { service: 'Servicio', tool: 'Herramienta gratuita', guide: 'Guía' },
  en: { service: 'Service', tool: 'Free tool', guide: 'Guide' },
  fr: { service: 'Service', tool: 'Outil gratuit', guide: 'Guide' },
};
const CTA: Record<Lang, { button: string; note: string }> = {
  es: { button: 'Evaluación privada', note: 'Respuesta en 24 h laborables · sin compromiso' },
  en: { button: 'Private evaluation', note: 'Reply within 24 working hours · no obligation' },
  fr: { button: 'Évaluation privée', note: 'Réponse sous 24 h ouvrées · sans engagement' },
};
---

<div class="sgh-list">
  <h1>{t.h1}</h1>
  <p class="sgh-list-intro">{t.intro}</p>
  {groups.map((g) => (
    <section class="sgh-pilar">
      <h2>{g.name}</h2>
      <p class="sgh-pilar-text">{g.text}</p>
      {g.pages.length > 0 ? (
        <div class="sgh-cards">
          {g.pages.map((p) => (
            <a class:list={['sgh-card', `sgh-card-${p.kind}`]} href={p.href}>
              <span class="sgh-kind">{KIND[lang][p.kind]}</span>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="sgh-soon"><a href={contactHref}>{t.soon}</a></p>
      )}
      <p class="sgh-pilar-cta"><a class="btn" href={`${contactHref}-${g.pilar}`}>{CTA[lang].button}</a><span>{CTA[lang].note}</span></p>
    </section>
  ))}
</div>
