---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactForm from '../../../components/contact/ContactForm.astro';
import { contactText, contactUrls } from '../../../i18n/contact';

const SITE_URL = 'https://spaingh.com';
const t = contactText['fr'];
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang="fr"
  canonicalUrl={`${SITE_URL}${contactUrls.fr}`}
  translations={[
    { lang: 'es', url: `${SITE_URL}${contactUrls.es}` },
    { lang: 'en', url: `${SITE_URL}${contactUrls.en}` },
  ]}
>
  <ContactForm lang="fr" />
</BaseLayout>
