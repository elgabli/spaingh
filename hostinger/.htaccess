RewriteRule ^fr/avocat\-immobilier\-espagne\-due\-diligence/?$ /fr/ [R=301,L]
RewriteRule ^fr/guide\-investissement\-immobilier\-madrid\-2026/?$ /fr/ [R=301,L]
