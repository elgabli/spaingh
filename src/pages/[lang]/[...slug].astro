---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { i18nConfig, withLangPrefix, type Lang } from '../../i18n/config';
import { pagesText, listingUrls } from '../../i18n/pages';
import { articleGraphSchema, webApplicationSchema, webPageSchema, serviceSchema, faqPageSchema, extractFaq, author } from '../../lib/schema';
import BeckhamCalculator from '../../components/islands/BeckhamCalculator.astro';
import NomadChecker from '../../components/islands/NomadChecker.astro';

const SITE_URL = 'https://spaingh.com';

type AnyEntry =
  | CollectionEntry<'pilares'>
  | CollectionEntry<'blog'>
  | CollectionEntry<'legal'>;

// Contenido que va DESPUÉS de la isla de la calculadora (metodología, FAQ,
// fuentes, disclaimer) — copiado de producción, no reescrito.
// Clave: idioma. Si falta para un idioma, no se renderiza nada.
const beckhamTails = import.meta.glob<string>('../../content-raw/beckham-tail-*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

export async function getStaticPaths() {
  const [pilares, blog, legal] = await Promise.all([
    getCollection('pilares'),
    getCollection('blog'),
    getCollection('legal'),
  ]);
  const all: AnyEntry[] = [...pilares, ...blog, ...legal];

  return all.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.data.slug },
    props: { entry, all },
  }));
}

const { entry, all } = Astro.props as { entry: AnyEntry; all: AnyEntry[] };
const { Content, headings } = await render(entry as any);
const lang = entry.data.lang as Lang;
const t = pagesText[lang];
const h1Text = entry.data.title.replace(/\s*\|\s*Spain Global Hub\s*$/i, '');
const isHtml = entry.data.format === 'html';

const canonicalUrl = `${SITE_URL}/${lang}/${entry.data.slug}/`;

// hreflang: todas las entradas que comparten translationGroup, en los demás idiomas.
const translations = all
  .filter((e) => e.data.translationGroup === entry.data.translationGroup && e.data.lang !== entry.data.lang)
  .map((e) => ({ lang: e.data.lang as Lang, url: `${SITE_URL}/${e.data.lang}/${e.data.slug}/` }));

// Las islas SOLO en sus páginas (calculadora / verificador), no en las
// páginas de servicio del mismo pilar. Se decide por el fichero fuente
// (src/content/pilares/<lang>/ley-beckham.md y nomada-digital.md).
const srcFile = (entry as { filePath?: string }).filePath ?? '';
const isBeckhamPillar = entry.collection === 'pilares' && /\/ley-beckham\.mdx?$/.test(srcFile);
const isNomadPillar = entry.collection === 'pilares' && /\/nomada-digital\.mdx?$/.test(srcFile);
const hasIsland = isBeckhamPillar || isNomadPillar;
const beckhamTail = isBeckhamPillar ? beckhamTails[`../../content-raw/beckham-tail-${lang}.html`] : undefined;

// Plantilla "artículo" (hero con imagen + índice lateral + tarjetas): blog y
// guías de pilar sin isla. Legales y páginas con isla: plantilla simple.
const isBlog = entry.collection === 'blog';
const isArticle = (isBlog || entry.collection === 'pilares') && !hasIsland;

// Imagen destacada: og:image solo si es foto real (no portada de marca .svg).
const image = entry.data.image;
const isPhoto = !!image && !/\.svg$/i.test(image);
const ogImage = isPhoto ? `${SITE_URL}${image}` : undefined;

// Cuerpo HTML (WordPress): se quita el H1 propio (el hero ya lo pinta), la
// imagen destacada si viene repetida, y se añaden ids a los H2 sin id para el índice.
const slugify = (s: string) =>
  s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/<[^>]+>/g, '').replace(/&[a-z#0-9]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
let htmlBody = entry.body ?? '';
let toc: { id: string; text: string }[] = [];
if (isHtml) {
  if (isArticle) {
    htmlBody = htmlBody.replace(/<h1[\s>][\s\S]*?<\/h1>/i, '');
    if (image) {
      const esc = image.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      htmlBody = htmlBody
        .replace(new RegExp(`<figure[^>]*>\\s*<img[^>]*src="${esc}"[^>]*>[\\s\\S]*?<\\/figure>`, 'i'), '')
        .replace(new RegExp(`<p[^>]*>\\s*<img[^>]*src="${esc}"[^>]*>\\s*<\\/p>`, 'i'), '')
        .replace(new RegExp(`<img[^>]*src="${esc}"[^>]*>`, 'i'), '');
    }
  }
  const used = new Set<string>();
  htmlBody = htmlBody.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/gi, (m, attrs: string, inner: string) => {
    const text = inner.replace(/<[^>]+>/g, '').replace(/&#8217;|&rsquo;/g, '’').replace(/&amp;/g, '&').trim();
    const idMatch = attrs.match(/\sid="([^"]+)"/);
    let id = idMatch ? idMatch[1] : slugify(text) || 'seccion';
    while (used.has(id)) id += '-2';
    used.add(id);
    toc.push({ id, text });
    return idMatch ? m : `<h2 id="${id}"${attrs}>${inner}</h2>`;
  });
} else {
  toc = headings.filter((h: { depth: number }) => h.depth === 2).map((h: { slug: string; text: string }) => ({ id: h.slug, text: h.text }));
}
const bodyHasH1 = isHtml ? /<h1[\s>]/i.test(htmlBody) : headings.some((h: { depth: number }) => h.depth === 1);

// Meta del artículo: fecha y tiempo de lectura.
const words = (entry.body ?? '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(words / 220));
const metaDate = entry.data.updatedDate ?? entry.data.publishedDate;
const dateFmt = new Intl.DateTimeFormat(i18nConfig[lang].locale.replace('_', '-'), { year: 'numeric', month: 'long', day: 'numeric' });

// Migas y tarjetas laterales.
const crumb = isBlog
  ? { href: listingUrls.blog[lang], label: i18nConfig[lang].nav.blog.label }
  : { href: listingUrls.services[lang], label: i18nConfig[lang].nav.services.label };
const pilares = all.filter((e) => e.collection === 'pilares' && e.data.lang === lang) as CollectionEntry<'pilares'>[];
const calc = pilares.find((e) => /\/ley-beckham\.mdx?$/.test((e as { filePath?: string }).filePath ?? ''));
const checker = pilares.find((e) => /\/nomada-digital\.mdx?$/.test((e as { filePath?: string }).filePath ?? ''));
const topic = `${entry.data.translationGroup} ${'pilar' in entry.data ? (entry.data as { pilar: string }).pilar : ''}`;
const tool = /beckham/i.test(topic) && calc
  ? { ...t.article.toolBeckham, href: withLangPrefix(lang, `/${calc.data.slug}/`) }
  : /nomad/i.test(topic) && checker
    ? { ...t.article.toolNomad, href: withLangPrefix(lang, `/${checker.data.slug}/`) }
    : { ...t.article.toolServices, href: listingUrls.services[lang] };
const contactHref = withLangPrefix(lang, `${i18nConfig[lang].nav.contact.href}?origen=${isBlog ? 'articulo' : 'pilar'}`);
// CTA intermedia (misma para Markdown —marcador del plugin rehype— y HTML —inserción tras el 3.º H2—).
const midCtaHtml = `<div class="sgh-mid-cta"><p><strong>${t.article.midCta.title}</strong>${t.article.midCta.text}</p><a class="btn" href="${withLangPrefix(lang, `${i18nConfig[lang].nav.contact.href}?origen=cta-articulo`)}">${t.article.midCta.button}</a><a class="wa" href="https://wa.me/34601555547" rel="noopener" target="_blank">${t.article.midCta.wa}</a></div>`;
if (isHtml && isArticle) {
  let n = 0; const h2s = (htmlBody.match(/<h2[\s>]/gi) || []).length; const at = h2s >= 4 ? 3 : 2;
  if (h2s >= 2) htmlBody = htmlBody.replace(/<h2[\s>]/gi, (m) => (++n === at ? midCtaHtml + m : m));
}

const isServicePage = entry.collection === 'pilares' && /\/(beckham-servicio|constitucion-empresas|nomada-servicio|pac-servicio)\.mdx?$/.test(srcFile);
const isAbout = entry.collection === 'legal' && /\/about\.mdx?$/.test(srcFile);
const imageUrl = (entry.data as { image?: string }).image ? `${SITE_URL}${(entry.data as { image?: string }).image}` : undefined;
const faqItems = extractFaq((entry.body ?? '') + '\n' + (beckhamTail ?? ''));
const schemaNodes = [
  author,
  webPageSchema({
    url: canonicalUrl, name: h1Text, description: entry.data.description, lang,
    datePublished: entry.data.publishedDate.toISOString(), dateModified: entry.data.updatedDate?.toISOString(),
    image: imageUrl, type: isAbout ? 'AboutPage' : 'WebPage',
  }),
  articleGraphSchema({
    url: canonicalUrl, headline: h1Text, description: entry.data.description, image: imageUrl, lang,
    datePublished: entry.data.publishedDate.toISOString(), dateModified: entry.data.updatedDate?.toISOString(),
    type: entry.collection === 'blog' ? 'BlogPosting' : 'Article',
  }),
  ...(isBeckhamPillar ? [webApplicationSchema({ url: canonicalUrl, name: h1Text, description: entry.data.description })] : []),
  ...(isServicePage ? [serviceSchema({ url: canonicalUrl, name: h1Text, description: entry.data.description, lang, serviceType: /beckham/.test(srcFile) ? 'Beckham Law tax advisory' : /nomada/.test(srcFile) ? 'Digital Nomad Visa application' : /pac/.test(srcFile) ? 'Highly Qualified Professional visa application' : 'Company formation in Spain' })] : []),
  ...(faqItems.length ? [faqPageSchema(faqItems)] : []),
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={lang}
  canonicalUrl={canonicalUrl}
  translations={translations}
  noindex={entry.data.noindex}
  schemaNodes={schemaNodes}
  ogImage={ogImage}
>
  {isArticle ? (
    <div class="sgh-post">
      <nav class="sgh-crumbs" aria-label="Breadcrumb">
        <a href={withLangPrefix(lang, '/')}>{t.article.home}</a> › <a href={crumb.href}>{crumb.label}</a>
      </nav>
      <div class="sgh-post-grid">
      <div class="sgh-post-main">
      <header class:list={['sgh-post-hero', { 'has-img': !!image }]}>
        {image && <img src={image} alt={entry.data.imageAlt ?? h1Text} width="1200" height="675" fetchpriority="high" />}
        <div class="in">
          <h1>{h1Text}</h1>
          <p class="meta">
            <span>{entry.data.updatedDate ? t.blog.updated : t.blog.published} <time datetime={metaDate.toISOString().slice(0, 10)}>{dateFmt.format(metaDate)}</time></span>
            <span>·</span>
            <span>{readMinutes} {t.blog.readTime}</span>
          </p>
        </div>
      </header>
        <article class="sgh-article sgh-post-body" data-mid-cta={midCtaHtml}>
          {isHtml ? <Fragment set:html={htmlBody} /> : <Content />}
          <Fragment set:html={midCtaHtml.replace('sgh-mid-cta', 'sgh-mid-cta sgh-end-cta')} />
        </article>
        <script>
          // Artículos Markdown: la CTA intermedia se inserta tras el 3.º H2 (2.º si hay pocos).
          // En los artículos HTML ya viene insertada en el servidor.
          document.querySelectorAll<HTMLElement>('.sgh-post-body').forEach((art) => {
            if (art.querySelector('.sgh-mid-cta:not(.sgh-end-cta)')) return;
            const h2 = art.querySelectorAll('h2'); if (h2.length < 2) return;
            const at = h2[h2.length >= 4 ? 2 : 1]; const tpl = document.createElement('template');
            tpl.innerHTML = art.getAttribute('data-mid-cta') || ''; at.before(tpl.content);
          });
        </script>
      </div>
        <aside class="sgh-post-side">
          {toc.length > 1 && (
            <nav class="sgh-toc" aria-label={t.article.toc}>
              <p class="tt">{t.article.toc}</p>
              <ol>
                {toc.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}
              </ol>
            </nav>
          )}
          <div class="sgh-side-card tool">
            <p class="tt">{tool.title}</p>
            <p>{tool.text}</p>
            <a class="btn" href={tool.href}>{tool.button}</a>
          </div>
          <div class="sgh-side-card contact">
            <p class="tt">{t.article.contact.title}</p>
            <p>{t.article.contact.text}</p>
            <a class="btn gold" href={contactHref}>{t.article.contact.button}</a>
          </div>
        </aside>
      </div>
    </div>
  ) : (
    <article class:list={['sgh-article', { 'sgh-beckham': isBeckhamPillar }]}>
      {/* .sgh-beckham en el <article>: el CSS original de la calculadora define
          .sghb-lead, .sghb-faq, .sghb-note… siempre bajo ese ancestro. */}
      {!bodyHasH1 && <h1>{h1Text}</h1>}
      {isNomadPillar && <NomadChecker lang={lang} />}
      {isHtml ? <Fragment set:html={htmlBody} /> : <Content />}
      {isBeckhamPillar && <BeckhamCalculator lang={lang} />}
      {beckhamTail && <Fragment set:html={beckhamTail} />}
    </article>
  )}
</BaseLayout>
