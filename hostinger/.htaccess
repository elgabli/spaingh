RewriteRule ^en/news/?$ /en/blog/ [R=301,L]
RewriteRule ^en/news/page(/.*)?$ /en/blog/ [R=301,L]
RewriteRule ^fr/actualites\-de\-sgh/?$ /fr/blog/ [R=301,L]
RewriteRule ^fr/visa\-dinvestisseur\-en\-espagne/?$ /fr/ [R=301,L]
RewriteRule ^fr/politica\-de\-cookies/?$ /fr/politique-de-cookies/ [R=301,L]
RewriteRule ^costa\-del\-sol\-best\-places\-to\-invest\-in\-spain/?$ /en/ [R=301,L]
RewriteRule ^en/alternative\-contact/?$ /en/contact/ [R=301,L]
RewriteRule ^es/contacto\-alternativo/?$ /es/contacto/ [R=301,L]
RewriteRule ^fr/contact\-alternatif/?$ /fr/contact/ [R=301,L]
RewriteRule ^es/terms\-of\-use/?$ /es/terminos-y-condiciones-de-uso/ [R=301,L]
RewriteRule ^en/property\-finder\-spain/?$ /en/ [R=301,L]
RewriteRule ^es/servicios/visado\-inversor/?$ /es/servicios/ [R=301,L]
RewriteRule ^wp\-content/uploads/2026/02/how\-to\-get\-spanish\-citizenship\-scaled\.jpg$ /img/get-spanish-citizenship-1200x801.jpg [R=301,L]
RewriteRule ^wp\-content/uploads/2026/02/get\-spanish\-citizenship\-scaled\.jpg$ /img/get-spanish-citizenship-1200x801.jpg [R=301,L]
RewriteRule ^wp\-content/uploads/2026/03/blueberry\-fruits\-scaled\.jpg$ /img/blueberry-fruits-1200x675.jpg [R=301,L]
RewriteRule ^wp\-content/uploads/2026/02/beckham\-law\-spain\-2026\-scaled\-e1771913990725\.jpg$ /img/beckham-law-spain-2026-scaled-e1771913990725.jpg [R=301,L]
RewriteRule ^wp\-content/uploads/2026/02/apply\-for\-highly\-qualified\-professional\-visa\-spain\-1\-scaled\.jpeg$ /img/apply-for-highly-qualified-professional-visa-spain-1-1200x750.jpeg [R=301,L]
RewriteRule ^es/beckham\-law\-calculator/?$ /es/calculadora-ley-beckham/ [R=301,L]
RewriteRule ^fr/beckham\-law\-calculator/?$ /fr/calculateur-loi-beckham/ [R=301,L]
RewriteRule ^sitemap_index\.xml$ /sitemap-index.xml [R=301,L]
RewriteRule ^wp\-sitemap\.xml$ /sitemap-index.xml [R=301,L]
RewriteRule ^post\-sitemap\.xml$ /sitemap-index.xml [R=301,L]
RewriteRule ^page\-sitemap\.xml$ /sitemap-index.xml [R=301,L]

# Restos del WordPress
RewriteRule ^(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|feed)(/|$) - [R=410,L]
RewriteRule ^wp-content/uploads/ - [R=410,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>
# Recursos con hash en el nombre (_astro/): cache larga
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
