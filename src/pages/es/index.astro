---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/home/Home.astro';

const SITE_URL = 'https://spaingh.com';
---

<BaseLayout
  title="Asesoría Privada para Inversores y Expatriados en España | Spain Global Hub"
  description="Asesoría legal, fiscal y de residencia para expatriados e inversores extranjeros en España: Ley Beckham, Nómada Digital, Profesional Altamente Cualificado y constitución de empresas."
  lang="es"
  fullBleed
  canonicalUrl={`${SITE_URL}/es/`}
  translations={[
    { lang: 'en', url: `${SITE_URL}/en/` },
    { lang: 'fr', url: `${SITE_URL}/fr/` },
  ]}
>
  <Home lang="es" />
</BaseLayout>
