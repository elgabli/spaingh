---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/listing/PostList.astro';
import { pagesText, listingUrls } from '../../../i18n/pages';

const SITE_URL = 'https://spaingh.com';
const t = pagesText['es'].blog;
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang="es"
  canonicalUrl={`${SITE_URL}${listingUrls.blog.es}`}
  translations={[
    { lang: 'en', url: `${SITE_URL}${listingUrls.blog.en}` },
    { lang: 'fr', url: `${SITE_URL}${listingUrls.blog.fr}` },
  ]}
>
  <PostList lang="es" />
</BaseLayout>
